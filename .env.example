# Copy this file to .env and fill in what you need. NEVER commit .env.
# Optional YouTube Data API key. Without it the YouTube collector uses the channel's
# public RSS feed (latest videos only, no statistics or comments) and company reports
# use RSS too. Create the key in Google Cloud console (free, no credit card):
#   1. console.cloud.google.com -> new project
#   2. Enable "YouTube Data API v3"
#   3. Credentials -> Create credentials -> API key
#   4. RESTRICT the key: API restrictions -> YouTube Data API v3 only.
#      If deploying to a server, also add an IP restriction for that host.
YOUTUBE_API_KEY=

# Daily quota accounting (YouTube grants 10,000 units/day, resets midnight Pacific).
# The app stops making fresh API calls at the soft stop.
QUOTA_DAILY_BUDGET=10000
QUOTA_SOFT_STOP=9500

# Cache TTLs (seconds)
TTL_LIST_S=86400            # company reports: web search results: 24h
TTL_STATIC_S=2592000        # Wikidata answers and vision descriptions: 30d

# Per-IP rate limits (slowapi syntax)
RATE_FRESH=10/minute        # creating a creator job
RATE_CACHED=60/minute       # reading jobs, dossiers and PDFs

# Company mechanism (python -m backend.company "<name>")
# Brave Search API key (brave.com/search/api). No free plan: a card is required and the
# Search plan includes about $5 of queries a month. Empty → DuckDuckGo (ddgs) only, which
# finds fewer competitors. One key only: several accounts break Brave's terms.
BRAVE_API_KEY=
# Contact URL or email for the User-Agent — Wikimedia APIs return 403 without one, and
# SEC EDGAR requires one too. Sent only to those two.
CONTACT_URL=

# Optional GitHub token for the GitHub collector and the company reports' new-repos count
# (github.com/settings/tokens, no scopes
# needed for public data). Empty works: 60 requests an hour instead of 5,000.
GITHUB_TOKEN=
